# Copiá este archivo a .env.local (que ya está en .gitignore) y completá con
# los datos reales de tu proyecto de Supabase (Project Settings → API Keys).
# Mientras estas variables no existan, el sitio funciona igual con datos de
# prueba en memoria (ver src/lib/data/store.ts).

NEXT_PUBLIC_SUPABASE_URL=
# La "Publishable key" de Supabase (antes llamada "anon key"). Es segura de
# exponer en el navegador siempre que las tablas tengan RLS configurado
# (nuestro esquema en supabase/migrations/0001_init.sql ya lo tiene).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
